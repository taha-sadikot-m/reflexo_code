# NeonDB
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/reflexo?sslmode=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# Redis (Upstash)
REDIS_URL=rediss://default:xxx@apn1-xxx.upstash.io:6379

# Encryption key for tokens (Fernet)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# AES-256-GCM key for Channel Framework credentials.
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
CHANNEL_ENCRYPTION_KEY=
# HMAC secret for short-lived, tenant-bound Connection Hub links.
CONNECTION_HUB_SECRET=
CHANNEL_MCP_HOST=127.0.0.1
CHANNEL_MCP_PORT=8022
CHANNEL_FRAMEWORK_MCP_URL=http://127.0.0.1:8022/mcp
PUBLIC_API_URL=http://localhost:8030
APP_BASE_URL=http://localhost:3000
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
OUTLOOK_WEBHOOK_CLIENT_STATE=
SLACK_SIGNING_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Embeddings (Core MCP / shared.embeddings)
GOOGLE_API_KEY=

# Optional — Core MCP escalate_to_owner (point at Meta MCP base URL when running)
META_MCP_URL=http://127.0.0.1:8021

# ReAct agent worker (python -m agent.worker)
# MCP streamable-HTTP endpoints (append /mcp if using base URLs above)
REFLEXO_CORE_MCP_URL=http://127.0.0.1:8020/mcp
# Agent Meta MCP tools URL (defaults to META_MCP_URL + /mcp when unset)
# META_MCP_MCP_URL=http://127.0.0.1:8021/mcp
AGENT_MODEL=gemini-2.5-flash
AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=1024

# Observability — Langfuse Cloud free tier (Stage 3). Leave empty to disable tracing.
# Sign up at https://cloud.langfuse.com → project API keys (do not commit real keys).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_BASE_URL is accepted as an alias of LANGFUSE_HOST
# Daily token cap per business (Redis tokens:{business_id}:{YYYY-MM-DD}). Default 500000.
TOKEN_DAILY_BUDGET=500000

# Stage 6 long-term customer memory (Mem0 + local Qdrant Docker)
MEM0_ENABLED=true
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=
MEM0_COLLECTION=reflexo_memories
MEM0_SEARCH_LIMIT=5
MEM0_TELEMETRY=false

# Stage 7 admin simulator SSE (API on :8030). JWT admin routes are preferred;
# this key remains as a local fallback for scripts.
SIMULATOR_API_KEY=

# Stage 8 admin panel + web widget
# Production MUST set a dedicated service-role DSN that bypasses RLS.
# Locally the API falls back to DATABASE_URL with a warning.
DATABASE_URL_SERVICE_ROLE=
ADMIN_JWT_SECRET=change-this-to-a-random-64-char-string
ADMIN_JWT_EXPIRY_HOURS=8
ADMIN_FRONTEND_ORIGIN=http://localhost:3000
# Comma-separated origins, or * for local widget demos
WIDGET_ALLOWED_ORIGINS=*
WIDGET_RATE_LIMIT_PER_MIN=30
ENVIRONMENT=development
NEXT_PUBLIC_API_URL=http://localhost:8030

# Official MCP Registry + remote OAuth callbacks
MCP_REGISTRY_URL=https://registry.modelcontextprotocol.io
MCP_REGISTRY_CACHE_SECONDS=3600
# Set to the public HTTPS API origin in production.
MCP_OAUTH_BASE_URL=http://127.0.0.1:8030

# Meta Platform (meta-mcp)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_APP_ID=
META_API_VERSION=v22.0
# Set false only on local Windows if Graph API hits SSL CERTIFICATE_VERIFY_FAILED
# (AV/corp proxy MITM). Prefer installing the interceptor CA; keep true in production.
META_HTTP_VERIFY=true

# WhatsApp channel seed / live smoke (scripts/seed_whatsapp_channel.py)
META_SYSTEM_ACCESS_TOKEN=          # System User or API Setup token
META_PHONE_NUMBER_ID=              # WhatsApp → API Setup → Phone number ID
META_TEST_RECIPIENT=+91XXXXXXXXXX  # your phone for --send smoke
# WHATSAPP_SEED_BUSINESS_ID=00000000-0000-0000-0000-000000000001

# Onboarding API (python -m api.server) — signup + Meta OAuth callback
API_PORT=8030
META_OAUTH_REDIRECT_URI=http://127.0.0.1:8030/api/oauth/callback
# META_OAUTH_SUCCESS_URL=https://reflexo.ai/onboarding/success
# META_OAUTH_ERROR_URL=https://reflexo.ai/onboarding/error
# Celery reminders: celery -A onboarding.celery_app worker -l info
#                   celery -A onboarding.celery_app beat -l info
# CELERY_BROKER_URL=   # defaults to REDIS_URL

# Stage 10 — WhatsApp Calling + LiveKit Cloud (never commit real keys)
# python -m voice.worker
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
VOICE_MAX_CALLS_PER_BUSINESS=5
VOICE_MAX_CALLS_GLOBAL=20
# Shared secret for meta-mcp /internal/* routes (outbound call trigger)
VOICE_INTERNAL_TOKEN=
# python -m voice.worker

# Stage 12 — Temporal (docker compose temporal-server / temporal-ui)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=reflexo-workflows
TEMPORAL_DB_PASSWORD=temporal_dev_password
# Temporal UI: http://localhost:8088
# Worker: python -m workflow_builder.worker

# Server ports
PORT=8020
META_MCP_PORT=8021
LOG_LEVEL=INFO

# Direct Channel Framework OAuth credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
